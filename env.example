# Configuración del servidor
PORT=3001
NODE_ENV=development

# Base de datos PostgreSQL (se configurará con Railway)
DATABASE_URL="postgresql://username:password@host:port/database"

# JWT Secret
JWT_SECRET="tu_jwt_secret_super_seguro_aqui"

# SendGrid para verificación de email
SENDGRID_API_KEY="tu_sendgrid_api_key"
SENDGRID_FROM_EMAIL="noreply@finzenai.com"

# OpenAI para Zenio
OPENAI_API_KEY="tu_openai_api_key"
OPENAI_ASSISTANT_ID="tu_openai_assistant_id"

# Configuración de CORS
CORS_ORIGIN="http://localhost:5173"

# URL del Frontend (para enlaces de verificación de email)
FRONTEND_URL="http://localhost:5173"

# Configuración de la aplicación
APP_NAME="FinZen AI"
APP_VERSION="1.0.0" 
# ── Gastos / Ingresos recurrentes ──────────────────────────────────────
# Todas OPCIONALES: si no se setean, aplican los defaults de
# src/config/recurringConfig.ts. Cambiarlas en Railway NO requiere deploy.

# Kill switch del motor. false = el cron no genera ninguna transacción
# automática (las reglas ya creadas quedan intactas). Default: true
RECURRING_ENABLED="true"

# Enviar push cuando se registran movimientos automáticos. Default: true
RECURRING_NOTIFY_ENABLED="true"

# Hora LOCAL del usuario (0-23) a la que se procesan sus recurrentes.
# El cron corre cada hora y usa esto como filtro fino, así cada usuario
# recibe su movimiento a una hora razonable de SU huso. Default: 6
RECURRING_RUN_LOCAL_HOUR="6"

# Máximo de ocurrencias que una regla genera en una sola corrida (protege
# el caso "server caído": no inyecta meses de transacciones de golpe).
# Default: 12
RECURRING_MAX_CATCHUP_PER_RUN="12"

# Cada cuánto se despierta el scheduler a mirar. Default: cada hora
RECURRING_CRON_SCHEDULE="0 * * * *"

# Sufijos que marcan el movimiento como automático en su descripción
RECURRING_SUFFIX_EXPENSE="Pago automático"
RECURRING_SUFFIX_INCOME="Ingreso automático"
RECURRING_SUFFIX_SEPARATOR=" · "
